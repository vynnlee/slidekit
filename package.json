{
  "name": "slidekit",
  "version": "0.1.0-beta",
  "description": "Slide decks as plain HTML: a vanilla engine, a local visual editor, a presenter view, and comments that coding agents can act on.",
  "license": "MIT",
  "author": "Seongbeen Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vynnlee/slidekit.git"
  },
  "homepage": "https://github.com/vynnlee/slidekit#readme",
  "bugs": {
    "url": "https://github.com/vynnlee/slidekit/issues"
  },
  "keywords": [
    "slides",
    "presentation",
    "html",
    "slide-deck",
    "editor",
    "bun",
    "claude-code",
    "mcp",
    "coding-agent"
  ],
  "private": true,
  "type": "module",
  "bin": {
    "slidekit": "app/server.ts"
  },
  "scripts": {
    "slidekit": "bun run app/server.ts",
    "bundle": "bun run bundler/bundle.ts",
    "deploy": "bun deploy/deploy.ts",
    "test": "bun scripts/test.ts",
    "test:changed": "bun scripts/test.ts --changed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.56.0",
    "motion": "^14.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "typescript": "^7.0.2"
  }
}
